# Copy this file to .env and fill in real values. .env itself is in
# .gitignore and is never committed - this .example file (with no real
# secrets) is what's safe to commit instead.
#
# Why .env instead of json/llm-config.json + json/smtp-config.json (older
# revisions of this project used those): committing real API keys/SMTP
# passwords in a tracked JSON file gets git pushes blocked by GitHub's
# secret-scanning push protection. Environment variables side-step that
# entirely since .env is never part of the repo.

# ---- LLM (Lease Abstraction extraction) ----
# Which provider is actually used - "openai" or "openrouter".
LLM_PROVIDER=openai

OPENAI_API_KEY=sk-proj-your-key-here
OPENAI_MODEL=gpt-4o

OPENROUTER_API_KEY=sk-or-v1-your-key-here
# Claude Sonnet (not another OpenAI model) - this is a genuinely different
# provider/model from OPENAI_MODEL above, which is the whole point of
# having a fallback: if OpenAI's own API is down/rate-limited/auth-broken,
# routing to yet another OpenAI model through OpenRouter wouldn't help.
OPENROUTER_MODEL=anthropic/claude-sonnet-4

# ---- SMTP (verification codes + Support acknowledgement emails) ----
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USERNAME=you@gmail.com
# Gmail: use an "app password" (Google Account -> Security -> 2-Step
# Verification -> App passwords), not your normal login password.
SMTP_PASSWORD=your-app-password-here
SMTP_SENDER_EMAIL=you@gmail.com
SMTP_USE_TLS=false
SMTP_EXPIRY_MINUTES=4

# ---- ShareFile / SharePoint integration (item 3 - "System Configuration")
# ----
# These are OPTIONAL. Leaving them blank is fine - the System
# Configuration dropdown just shows "not set up yet" for ShareFile/
# SharePoint and stays on Desktop, nothing breaks. To make a real
# connection possible, register an app with the provider yourself (this
# is a one-time setup only the account owner can do - Claude/the
# developer of this codebase cannot register an app on your behalf):
#
#   ShareFile: https://developer.sharefile.com -> create an app -> you'll
#   get a Client ID + Client Secret, and you choose your own subdomain
#   (the "https://<subdomain>.sharefile.com" your company uses).
#   Add this exact Redirect URI in the app's settings:
#     https://<your-deployed-domain>/api/integrations/callback
#
#   SharePoint (via Microsoft Graph): https://portal.azure.com -> Azure
#   Active Directory -> App registrations -> New registration. You'll get
#   a Client ID (Application ID), a Client Secret (under Certificates &
#   secrets), and your Tenant ID. Add API permission Files.ReadWrite.All
#   (delegated), and add this exact Redirect URI under Authentication:
#     https://<your-deployed-domain>/api/integrations/callback
#
# SHAREFILE_CLIENT_ID=
# SHAREFILE_CLIENT_SECRET=
# SHAREFILE_SUBDOMAIN=yourcompany
#
# SHAREPOINT_CLIENT_ID=
# SHAREPOINT_CLIENT_SECRET=
# SHAREPOINT_TENANT_ID=common

