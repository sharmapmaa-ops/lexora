__pycache__/
*.pyc
# Real secrets (API keys, SMTP password) - see .env.example for the
# template. Never commit the real .env; GitHub's push protection will
# block commits containing real API keys/passwords anyway.
.env
*.log

# Real per-user data generated at runtime (profile photos, uploaded lease
# documents, Output.json/Output.pdf, staging files) - not sample data,
# shouldn't be committed.
Users/*/
!Users/.gitkeep
